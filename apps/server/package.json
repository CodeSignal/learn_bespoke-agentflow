{
  "name": "@agentflow/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --ignore ../web --ignore ../../data src/index.ts",
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentflow/types": "file:../../packages/types",
    "@agentflow/workflow-engine": "file:../../packages/workflow-engine",
    "@anthropic-ai/sdk": "^1.10.0",
    "@openai/agents": "^0.22.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
