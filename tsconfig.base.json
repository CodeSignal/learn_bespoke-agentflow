{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@agentflow/types": [
        "./packages/types/src/index.ts"
      ],
      "@agentflow/workflow-engine": [
        "./packages/workflow-engine/src/index.ts"
      ]
    },
    "declarationMap": true,
    "types": [
      "node"
    ]
  }
}
